# Copy to .env and adjust. Only deployment-specific values live here; every other
# tunable belongs in config/default.yaml.

# JWT signing key. Required outside local development — without it the config loader
# falls back to an insecure dev key and logs a warning.
NIDRA_SECRET_KEY=change-me

# Datastores. Defaults below match docker compose's published ports.
NIDRA_REDIS_URL=redis://localhost:6379/0
NIDRA_POSTGRES_URL=postgresql+asyncpg://nidra:nidra@localhost:5432/nidra

# Optional: point the loader at an alternative YAML config.
# NIDRA_CONFIG_PATH=config/default.yaml
